# Supabase Client Configuration (Public Anonymous Access Only)
# Copy this file to frontend/.env and replace with your actual Supabase credentials.
# NOTE: Never store service_role keys, database passwords, or private secrets in frontend environment files!
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Feature Flags
# Controls whether one-click demo persona quick-login buttons are enabled on the login screen
VITE_ENABLE_DEMO_LOGIN=true

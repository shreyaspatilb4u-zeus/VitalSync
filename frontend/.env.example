# Supabase Configuration
# Replace with your actual Supabase project URL and anon public key when connecting backend.
# NOTE: Never store service-role secrets in client environment variables!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Feature Flags
# Controls whether one-click demo login buttons are enabled on the login screen (prototype mode)
VITE_ENABLE_DEMO_LOGIN=true
